# Disable directory listing
Options -Indexes

# Default charset
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Hapus index.php dari URL (Redirect 301)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.php\ HTTP/
    RewriteRule ^index\.php$ / [R=301,L]

    # URL Rewrite untuk halaman lain tanpa .php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L]

    # Enforce HTTPS if SSL is available (exempt /api/ for ESP8266 HTTP compatibility)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{REQUEST_URI} !^.*/api/.*$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block direct access to hidden files and directories
    RewriteRule (^\.|/\.) - [F,L]

    # Block direct access to sensitive file extensions
    RewriteRule \.(env.*|sql|md|log|ini|git.*|ino|py|sh|bak)$ - [F,L]

    # Block direct access to internal project directories
    RewriteRule ^(arduino|python|sql|exports)(/|$) - [F,L]

    # Do not rewrite real existing files or directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Pretty URL: Clean routes for web panels
    RewriteRule ^(dashboard|rekap|mahasiswa|tambah|events|proker)/?$ index.php?panel=$1 [L,QSA]

    # Pretty URL: Extensionless PHP files (e.g. /login -> login.php, /api/events -> api/events.php)
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.php -f [OR]
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>

# Protect config files from direct web requests
<FilesMatch "^(config\.php|\.env.*|.*\.sql|.*\.txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Security response headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Browser caching for static frontend assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# Gzip compression for text, scripts, and stylesheets
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# Prevent PHP error leakage in production
<IfModule mod_php7.c>
    php_flag display_errors off
    php_flag log_errors on
</IfModule>
<IfModule mod_php8.c>
    php_flag display_errors off
    php_flag log_errors on
</IfModule>
